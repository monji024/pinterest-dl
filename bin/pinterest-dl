#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/pinterest-dl'
require 'optparse'

def usage
  <<~USAGE
    pinterest-dl v#{PinterestDL::VERSION}

    Usage:
      pinterest-dl image URL [-q QUALITY] [-o FILE]
      pinterest-dl video URL [-o FILE]
      pinterest-dl media URL [-q QUALITY]
      pinterest-dl search QUERY [-n LIMIT] [-t TYPE] [-q QUALITY] [-j JOBS] [-o DIR]
      pinterest-dl board URL [-n LIMIT] [-t TYPE] [-q QUALITY] [-j JOBS] [-o DIR]

    Options:
      -o, --output PATH       File (image/video) or directory (search/board) to save to
      -n, --limit N           Max number of results (search/board), default 25
      -t, --type TYPE         What to collect in search/board: all, image, video, pin (default all)
      -q, --quality Q         Image quality: originals, 1200x, 736x, 564x, 474x, 236x (default originals)
      -c, --cookies STR|FILE  Cookie header string or Netscape cookies.txt file path
      -j, --jobs N            Parallel download workers for batch downloads (default 4)
      -s, --skip-existing     Skip files that already exist on disk
          --proxy URL         HTTP/HTTPS proxy URL
          --timeout SEC       Network read/open timeout in seconds
          --retries N         Max retries on transient failures (default 3)
      -v, --verbose           Enable debug logging
          --version           Print version and exit
      -h, --help              Show this help
  USAGE
end

options = {
  limit: 25,
  quality: :originals,
  type: :all,
  jobs: 4,
  skip_existing: false,
  verbose: false
}

parser = OptionParser.new do |opts|
  opts.on('-o PATH', '--output PATH') { |v| options[:output] = v }
  opts.on('-n N', '--limit N', Integer) { |v| options[:limit] = v }
  opts.on('-t T', '--type T') { |v| options[:type] = v.to_sym }
  opts.on('-q Q', '--quality Q') { |v| options[:quality] = v.to_sym }
  opts.on('-c STR', '--cookies STR') { |v| options[:cookies] = v }
  opts.on('-j N', '--jobs N', Integer) { |v| options[:jobs] = v }
  opts.on('-s', '--skip-existing') { options[:skip_existing] = true }
  opts.on('--proxy URL') { |v| options[:proxy] = v }
  opts.on('--timeout SEC', Integer) { |v| options[:timeout] = v }
  opts.on('--retries N', Integer) { |v| options[:retries] = v }
  opts.on('-v', '--verbose') { options[:verbose] = true }
  opts.on('--version') do
    puts PinterestDL::VERSION
    exit 0
  end
  opts.on('-h', '--help') do
    puts usage
    exit 0
  end
end

begin
  parser.parse!(ARGV)
rescue OptionParser::ParseError => e
  warn "pinterest-dl: #{e.message}"
  exit 1
end

command = ARGV.shift
target = ARGV.shift

if command.nil? || target.nil?
  puts usage
  exit(command.nil? ? 0 : 1)
end

def die(message, code = 1)
  warn "pinterest-dl: #{message}"
  exit code
end

def handle_pins(pins, options)
  if pins.empty?
    warn 'No matching pins found'
    return
  end

  if options[:type] == :pin
    links = pins.map { |p| p[:pin_url] }
    if options[:output]
      FileUtils.mkdir_p(options[:output])
      out_file = File.join(options[:output], 'pins.txt')
      File.write(out_file, "#{links.join("\n")}\n")
      puts "Saved #{links.size} pin links to #{out_file}"
    else
      puts links
    end
  elsif options[:output]
    urls = pins.filter_map do |p|
      options[:type] == :image ? p[:image_url] : (p[:video_url] || p[:image_url])
    end
    bar = PinterestDL::ProgressBar.new(total: urls.size, out: $stderr)
    result = PinterestDL.download_batch(
      urls,
      dir: options[:output],
      concurrency: options[:jobs],
      overwrite: !options[:skip_existing]
    ) { |done, _total, _| bar.update(done) }
    skipped_msg = result[:skipped]&.any? ? " (#{result[:skipped].size} skipped)" : ''
    puts "Downloaded #{result[:succeeded].size}/#{urls.size} files to #{options[:output]}#{skipped_msg}"
    exit 1 if result[:succeeded].empty? && result[:failed].any?
  else
    puts JSON.pretty_generate(pins)
  end
end

begin
  PinterestDL.configure do |c|
    c.cookies = options[:cookies] if options[:cookies]
    c.quality = options[:quality] if options[:quality]
    c.concurrency = options[:jobs] if options[:jobs]
    c.overwrite = !options[:skip_existing]
    c.proxy = options[:proxy] if options[:proxy]
    if options[:timeout]
      c.open_timeout = options[:timeout]
      c.read_timeout = options[:timeout]
    end
    c.max_retries = options[:retries] if options[:retries]
    c.logger.level = Logger::DEBUG if options[:verbose]

# step-3
