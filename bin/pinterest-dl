#!/usr/bin/env ruby
# Monji024
require_relative '../lib/pinterest-dl'
require 'optparse'

def usage
  <<~USAGE
    pinterest-dl v#{PinterestDL::VERSION}

    Usage:
      pinterest-dl image URL [-o FILE]
      pinterest-dl video URL [-o FILE]
      pinterest-dl search QUERY [-n LIMIT] [-t TYPE] [-o DIR]
      pinterest-dl board URL [-n LIMIT] [-t TYPE] [-o DIR]

    Options:
      -o, --output PATH   File (image/video) or directory (search/board) to save to
      -n, --limit N       Max number of results (search/board), default 25
      -t, --type TYPE     What to collect in search/board: all, image, video, pin (default all)
      -q, --quality Q     Image quality: originals, 736x, 474x, 236x (default originals)
      -c, --cookies STR   Cookie string for authenticated requests
      -v, --verbose       Print debug logging
      -h, --help          Show this help
  USAGE
end

options = { limit: 25, quality: :originals, type: :all }
parser = OptionParser.new do |opts|
  opts.on('-o PATH', '--output PATH') { |v| options[:output] = v }
  opts.on('-n N', '--limit N', Integer) { |v| options[:limit] = v }
  opts.on('-t T', '--type T') { |v| options[:type] = v.to_sym }
  opts.on('-q Q', '--quality Q') { |v| options[:quality] = v.to_sym }
  opts.on('-c STR', '--cookies STR') { |v| options[:cookies] = v }
  opts.on('-v', '--verbose') { options[:verbose] = true }
  opts.on('-h', '--help') do
    puts usage
    exit 0
  end
end

begin
  parser.parse!(ARGV)
rescue OptionParser::ParseError => e
  warn "pinterest-dl: #{e.message}"
  exit 1
end

command = ARGV.shift
target = ARGV.shift

if command.nil? || target.nil?
  puts usage
  exit(command.nil? ? 0 : 1)
end

PinterestDL.configure do |c|
  c.cookies = options[:cookies] if options[:cookies]
  c.logger.level = Logger::DEBUG if options[:verbose]
end

def die(message)
  warn "pinterest-dl: #{message}"
  exit 1
end

def handle_pins(pins, options)
  if pins.empty?
    puts 'No matching pins found'
    return
  end

  if options[:type] == :pin
    links = pins.map { |p| p[:pin_url] }
    if options[:output]
      FileUtils.mkdir_p(options[:output])
      File.write(File.join(options[:output], 'pins.txt'), "#{links.join("\n")}\n")
      puts "Saved #{links.size} pin links to #{options[:output]}/pins.txt"
    else
      puts links
    end
  elsif options[:output]
    urls = pins.filter_map { |p| p[:video_url] || p[:image_url] }
    bar = PinterestDL::ProgressBar.new(total: urls.size)
    result = PinterestDL.download_batch(urls, dir: options[:output]) { |done, _total, _| bar.update(done) }
    puts "Downloaded #{result[:succeeded].size}/#{urls.size} files to #{options[:output]}"
  else
    puts JSON.pretty_generate(pins)
  end
end

begin
  case command
  when 'image'
    url = PinterestDL.get_image_url(target, quality: options[:quality])
    if options[:output]
      PinterestDL.download(url, path: options[:output])
      puts "Saved to #{options[:output]}"
    else
      puts url
    end
  when 'video'
    url = PinterestDL.get_video_url(target)
    if options[:output]
      PinterestDL.download(url, path: options[:output])
      puts "Saved to #{options[:output]}"
    else
      puts url
    end
  when 'search'
    handle_pins(PinterestDL.search(target, limit: options[:limit], type: options[:type]), options)
  when 'board'
    handle_pins(PinterestDL.board(target, limit: options[:limit], type: options[:type]), options)
  else
    die "unknown command '#{command}'\n\n#{usage}"
  end
rescue PinterestDL::Error, ArgumentError => e
  die e.message
end
